{
  "kind": "collectionType",
  "collectionName": "news_items",
  "info": {
    "singularName": "news-item",
    "pluralName": "news-items",
    "displayName": "News Item",
    "description": "News/blog post migrated from WordPress"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text"
    },
    "content": {
      "type": "text"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag"
    },
    "author": {
      "type": "string"
    },
    "publishedDate": {
      "type": "datetime"
    },
    "legacyWpId": {
      "type": "integer"
    },
    "externalUrl": {
      "type": "text",
      "description": "The WP listing page's \"Read more\" link when it points off-site (e.g. press coverage, an award page) rather than to a page on this site"
    },
    "sortOrder": {
      "type": "integer"
    }
  }
}

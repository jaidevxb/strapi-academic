{
  "kind": "collectionType",
  "collectionName": "event_items",
  "info": {
    "singularName": "event-item",
    "pluralName": "event-items",
    "displayName": "Event",
    "description": "Event migrated from WordPress"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text"
    },
    "content": {
      "type": "text"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category"
    },
    "startDate": {
      "type": "datetime"
    },
    "endDate": {
      "type": "datetime"
    },
    "location": {
      "type": "string"
    },
    "format": {
      "type": "enumeration",
      "enum": ["In person", "Online", "Hybrid"],
      "default": "In person"
    },
    "registrationUrl": {
      "type": "text"
    },
    "speakers": {
      "type": "json",
      "description": "Array of speaker names"
    },
    "legacyWpId": {
      "type": "integer"
    }
  }
}

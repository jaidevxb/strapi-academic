{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project",
    "description": "Research project migrated from WordPress"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "shortDescription": {
      "type": "text"
    },
    "description": {
      "type": "text"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag"
    },
    "researchers": {
      "type": "json",
      "description": "Array of team-member slugs"
    },
    "funder": {
      "type": "string"
    },
    "projectStatus": {
      "type": "enumeration",
      "enum": ["Ongoing", "Completed"],
      "default": "Ongoing"
    },
    "publishedDate": {
      "type": "datetime"
    },
    "legacyWpId": {
      "type": "integer"
    }
  }
}

{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "Catch-all for WordPress content that doesn't fit a typed collection (Team/News/Events/Resources/Projects/Podcasts/Films)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text"
    },
    "content": {
      "type": "text"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "seoDescription": {
      "type": "text"
    },
    "publishedDate": {
      "type": "datetime"
    },
    "legacyWpId": {
      "type": "integer"
    }
  }
}

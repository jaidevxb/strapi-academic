{
  "kind": "collectionType",
  "collectionName": "resources",
  "info": {
    "singularName": "resource",
    "pluralName": "resources",
    "displayName": "Resource",
    "description": "Publication/resource migrated from WordPress"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text"
    },
    "content": {
      "type": "text"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "resourceType": {
      "type": "enumeration",
      "enum": ["Book", "Journal article", "Report", "Policy brief", "Dataset"],
      "default": "Report"
    },
    "authors": {
      "type": "json",
      "description": "Array of author names"
    },
    "publisher": {
      "type": "string"
    },
    "openAccess": {
      "type": "boolean",
      "default": true
    },
    "externalUrl": {
      "type": "text"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag"
    },
    "publishedDate": {
      "type": "datetime"
    },
    "legacyWpId": {
      "type": "integer"
    }
  }
}
